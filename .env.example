# Copy to `.env` at the repo root. `start.sh` links it to `backend/.env`,
# which is what `backend/config.py::Settings` reads. In production, paste
# the same values into Railway → Variables. Names are case-insensitive.

# --- News APIs (optional, all free tier) -------------------------------------
NEWSDATA_API_KEY=
NEWSAPI_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=
GDELT_ENABLED=true
# Comma-separated RSS/Atom feeds. These require no API key.
NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://www.france24.com/en/rss
# Translate non-English article titles/descriptions before displaying them.
NEWS_TRANSLATE_TO_ENGLISH=true
NEWS_TRANSLATION_MODEL=claude-sonnet-4-6

# --- LLM providers (at least one required for the LLM tab) ------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Ollama (local LLM, optional) -------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=ollama:llama3.2

# --- Refresh intervals (minutes) --------------------------------------------
COMMODITY_REFRESH_MINUTES=1
NEWS_REFRESH_MINUTES=1
POLYMARKET_REFRESH_MINUTES=1
PODCAST_REFRESH_MINUTES=30

# --- Database ---------------------------------------------------------------
# Local dev: leave DATABASE_URL empty and SQLite at DB_PATH is used.
# Production: paste the Supabase Postgres URI here.
DB_PATH=geopo.db
DATABASE_URL=

# --- Auth (Supabase) --------------------------------------------------------
# When SUPABASE_JWT_SECRET is empty, JWT verification is bypassed and the
# API runs in dev mode (NO auth). Required in production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
ALLOWED_EMAILS=
